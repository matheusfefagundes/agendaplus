DATABASE_URL=postgresql://agendaplus:agendaplus@localhost:5433/agendaplus
# Defina DATABASE_SSL_INSECURE=true só se o provedor usar certificado
# autoassinado que o Node não reconhece (desliga a validação TLS do Postgres).
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
# 32 bytes aleatórios em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=troque-por-32-bytes-aleatorios-em-base64
APP_URL=http://localhost:3000
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
BREVO_API_KEY=xkeysib_substitua_pela_sua_chave
# Cadastre e verifique este endereço em Settings > Senders na Brevo.
BREVO_SENDER_EMAIL=seu-email@gmail.com
BREVO_SENDER_NAME=Agenda+
# Opcional: se omitido, o teste envia para BREVO_SENDER_EMAIL.
BREVO_TEST_RECIPIENT=destinatario@gmail.com
